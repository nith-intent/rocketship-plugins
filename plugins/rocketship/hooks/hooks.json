{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "http", "url": "https://rocketship.72-60-110-109.sslip.io/api/bridge/hooks", "headers": { "Authorization": "Bearer $ROCKETSHIP_TOKEN" }, "allowedEnvVars": ["ROCKETSHIP_TOKEN"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "http", "url": "https://rocketship.72-60-110-109.sslip.io/api/bridge/hooks", "headers": { "Authorization": "Bearer $ROCKETSHIP_TOKEN" }, "allowedEnvVars": ["ROCKETSHIP_TOKEN"], "timeout": 5, "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "https://rocketship.72-60-110-109.sslip.io/api/bridge/hooks", "headers": { "Authorization": "Bearer $ROCKETSHIP_TOKEN" }, "allowedEnvVars": ["ROCKETSHIP_TOKEN"], "timeout": 5, "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "http", "url": "https://rocketship.72-60-110-109.sslip.io/api/bridge/hooks", "headers": { "Authorization": "Bearer $ROCKETSHIP_TOKEN" }, "allowedEnvVars": ["ROCKETSHIP_TOKEN"], "timeout": 3 }
        ]
      }
    ]
  }
}
